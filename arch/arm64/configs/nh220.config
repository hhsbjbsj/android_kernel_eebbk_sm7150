# Configs for EEBBK P22NH220(T1/T3) By XiKoTaSu

# Mach
CONFIG_MACH_EEBBK_P22NH220=y

# BBK Configs
CONFIG_BBK_VIP_THREAD=y
CONFIG_BBK_RAMEXT=y
# CONFIG_BBK_RAMEXT_FILE_LRU is not set
CONFIG_BBK_RAMEXT_BSWAPD=y
# CONFIG_BBK_RAMEXT_BSWAPD_SHRINK is not set
CONFIG_BBK_RAMEXT_DEBUG=y
CONFIG_BBK_RAMEXT_CORE=y
CONFIG_VENDOR_BBK_EDIT=y
CONFIG_BBK_BINDER_FG_REQ_FIRST=y
CONFIG_BBK_BINDER_UNFREEZER=y

# Touch Screen
CONFIG_TOUCHSCREEN_FTS=y
CONFIG_TOUCHSCREEN_FTS_DIRECTORY="focaltech_touch"

# Debug and watchdog
CONFIG_QCOM_WATCHDOG_V2=y
# CONFIG_QCOM_FORCE_WDOG_BITE_ON_PANIC is not set
# CONFIG_QCOM_WDOG_IPI_ENABLE is not set
# CONFIG_PANIC_ON_RECURSIVE_FAULT is not set
# CONFIG_DETECT_HUNG_TASK is not set
# CONFIG_WQ_WATCHDOG is not set
# CONFIG_PANIC_ON_OOPS is not set
CONFIG_PANIC_ON_OOPS_VALUE=0
CONFIG_PANIC_TIMEOUT=5
CONFIG_PSTORE=y
CONFIG_PSTORE_ZLIB_COMPRESS=y
# CONFIG_PSTORE_LZO_COMPRESS is not set
# CONFIG_PSTORE_LZ4_COMPRESS is not set
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# Built in
CONFIG_WIL6210=y
CONFIG_MSM_RDBG=y     
CONFIG_DVB_MPQ=y
CONFIG_DVB_MPQ_DEMUX=y
CONFIG_MMC_TEST=y
CONFIG_MSM_11AD=y
CONFIG_QCOM_LLCC_PERFMON=y

# WLAN
CONFIG_QCA_CLD_WLAN=y

# Modules
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
# CONFIG_MODVERSIONS is not set
# CONFIG_MODULE_SIG is not set
# CONFIG_MODULE_SIG_FORCE is not set
# CONFIG_MODULE_SIG_SHA512 is not set

# SELinux Always Permissive
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_ALWAYS_PERMISSIVE=y

# Container, Namespace & Cgroup Support for Android 17 / HyperOS
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_MEMCG_SWAP_ENABLED=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_NET_CLS_CGROUP=y
CONFIG_OVERLAY_FS=y
CONFIG_POSIX_MQUEUE=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_PROC_UID=y
CONFIG_SECURITY_SELINUX_CHECKREQPROT_VALUE=0
# CONFIG_BPF_UNPRIV_DEFAULT_OFF is not set
CONFIG_CMDLINE=""


