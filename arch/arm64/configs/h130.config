# Configs for EEBBK P20H130(S6) By XiKoTaSu

# Pwms
# CONFIG_INPUT_PWM_BEEPER is not set
# CONFIG_INPUT_PWM_VIBRA is not set
CONFIG_VIB_PWM=y
# CONFIG_SENSORS_PWM_FAN is not set
# CONFIG_REGULATOR_PWM is not set
# CONFIG_BACKLIGHT_PWM is not set
# CONFIG_LEDS_PWM is not set
# CONFIG_COMMON_CLK_PWM is not set
CONFIG_PWM=y
CONFIG_PWM_SYSFS=y
# CONFIG_PWM_FSL_FTM is not set
# CONFIG_PWM_PCA9685 is not set
# CONFIG_PWM_QCOM is not set
CONFIG_PWM_QTI_LPG=y

# BBK Configs
CONFIG_BBK_VIP_THREAD=y
CONFIG_BBK_RAMEXT=y
# CONFIG_BBK_RAMEXT_FILE_LRU is not set
CONFIG_BBK_RAMEXT_BSWAPD=y
# CONFIG_BBK_RAMEXT_BSWAPD_SHRINK is not set
CONFIG_BBK_RAMEXT_DEBUG=y
CONFIG_BBK_RAMEXT_CORE=y
CONFIG_VENDOR_BBK_EDIT=y
CONFIG_BBK_BINDER_FG_REQ_FIRST=y
CONFIG_BBK_BINDER_UNFREEZER=y

# Touch Screen
CONFIG_TOUCHSCREEN_FTS=y
CONFIG_TOUCHSCREEN_FTS_DIRECTORY="focaltech_touch"

# Debug and watchdog
CONFIG_QCOM_WATCHDOG_V2=y
# CONFIG_QCOM_FORCE_WDOG_BITE_ON_PANIC is not set
# CONFIG_QCOM_WDOG_IPI_ENABLE is not set
# CONFIG_PANIC_ON_RECURSIVE_FAULT is not set
# CONFIG_DETECT_HUNG_TASK is not set
# CONFIG_WQ_WATCHDOG is not set
# CONFIG_PANIC_ON_OOPS is not set
CONFIG_PANIC_ON_OOPS_VALUE=0
CONFIG_PANIC_TIMEOUT=5
CONFIG_PSTORE=y
CONFIG_PSTORE_ZLIB_COMPRESS=y
# CONFIG_PSTORE_LZO_COMPRESS is not set
# CONFIG_PSTORE_LZ4_COMPRESS is not set
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# Halls
CONFIG_INPUT_HALL=y
CONFIG_INPUT_MXM1120_UP=y
# CONFIG_INPUT_MXM1120_MIDDLE is not set
CONFIG_INPUT_MXM1120_DOWN=y
CONFIG_INPUT_IST8801=y

# Built in
CONFIG_WIL6210=y
CONFIG_MSM_RDBG=y     
CONFIG_DVB_MPQ=y
CONFIG_DVB_MPQ_DEMUX=y
CONFIG_MMC_TEST=y
CONFIG_MSM_11AD=y
CONFIG_QCOM_LLCC_PERFMON=y

# WLAN
CONFIG_QCA_CLD_WLAN=y

# Modules
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
# CONFIG_MODVERSIONS is not set
# CONFIG_MODULE_SIG is not set
# CONFIG_MODULE_SIG_FORCE is not set
# CONFIG_MODULE_SIG_SHA512 is not set
# ReSukiSU and SUSFS Configuration
CONFIG_KSU=y
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_SUS_MAP=y
CONFIG_BUILD_ARM64_KERNEL_COMPRESSION_GZIP=y

# BPF Configuration
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_JIT=y
CONFIG_HAVE_EBPF_JIT=y
CONFIG_BPF_EVENTS=y
CONFIG_CGROUP_BPF=y
CONFIG_NETFILTER_XT_MATCH_BPF=y
CONFIG_NET_CLS_BPF=y

# EROFS Filesystem Support
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_PCPU_KTHREAD=y
CONFIG_EROFS_FS_PCPU_KTHREAD_HIPRI=y

# SELinux Permissive and Bring-up Configuration
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_SECURITY_SELINUX_BOOTPARAM_VALUE=1
CONFIG_BBK_DEBUG_BRINGUP=y

# Re-Kernel Support (Disabled to prevent netlink collisions and memory instability)
# CONFIG_REKERNEL is not set

# Kallsyms
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y

# ADIOS IO Scheduler
CONFIG_MQ_IOSCHED_DEADLINE=y
CONFIG_MQ_IOSCHED_ADIOS=y

# Network Enhancements
CONFIG_WIREGUARD=y
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NETFILTER_XT_SET=y
CONFIG_CIFS=y
CONFIG_CIFS_XATTR=y
CONFIG_CIFS_POSIX=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_TUN=y
CONFIG_VETH=y

# TCP BBR & Brutal & FQ
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_TCP_CONG_BRUTAL=y
CONFIG_DEFAULT_TCP_CONG="cubic"
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y

# Container and Namespace Support (Aligned with Android standards)
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
# CONFIG_USER_NS is not set
# CONFIG_PID_NS is not set
CONFIG_NET_NS=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
# CONFIG_RT_GROUP_SCHED is not set
# CONFIG_CGROUP_PIDS is not set
CONFIG_CGROUP_FREEZER=y
CONFIG_CPUSETS=y
# CONFIG_CGROUP_DEVICE is not set
CONFIG_CGROUP_CPUACCT=y
# CONFIG_CGROUP_PERF is not set
CONFIG_OVERLAY_FS=y
CONFIG_POSIX_MQUEUE=y



